<?xml version="1.0" encoding="UTF-8"?>
<ControlList>
    <Control Name="OpcUaBoolControl" Caption="OPC UA 布尔控制">
        <JavaClass>com.systar.monitor.drivers.opcua.OpcUaControl</JavaClass>
        <DataType>BOOLEAN</DataType>
        <ViewType>YESNO</ViewType>
        <PropertyList>
            <Property Name="NodeId" Caption="节点标识" Required="true">
                <DataType>STRING</DataType>
            </Property>
        </PropertyList>
        <Source>OpcUaService</Source>
    </Control>

    <Control Name="OpcUaFloatControl" Caption="OPC UA 浮点控制">
        <JavaClass>com.systar.monitor.drivers.opcua.OpcUaControl</JavaClass>
        <DataType>FLOAT</DataType>
        <ViewType>SLIDER</ViewType>
        <PropertyList>
            <Property Name="NodeId" Caption="节点标识" Required="true">
                <DataType>STRING</DataType>
            </Property>
        </PropertyList>
        <Source>OpcUaService</Source>
    </Control>
</ControlList>
