<?xml version="1.0" encoding="UTF-8"?>
<ProbeList>
    <Probe Name="BACnetBool" Caption="BACnet 线圈状态" Interval="10m">
        <JavaClass>com.systar.monitor.drivers.bacnet.BacnetProbe</JavaClass>
        <DataType>BOOLEAN</DataType>
        <ViewType>YESNO</ViewType>
        <PropertyList>
            <Property Name="ObjectType" Caption="对象类型 ID" Required="true">
                <DataType Min="0" Max="30">INT</DataType>
            </Property>
            <Property Name="InstanceNumber" Caption="对象编号" Required="true">
                <DataType Min="0">INT</DataType>
            </Property>
            <Property Name="PropertyIdentifier" Caption="属性 ID" Required="true" Default="85">
                <DataType Min="0" Max="341">INT</DataType>
            </Property>
        </PropertyList>
        <Source>BACnetService</Source>
        <Description>0—关，1—开</Description>
    </Probe>

    <Probe Name="BACnetFloat" Caption="BACnet 浮点输入" Interval="30m">
        <JavaClass>com.systar.monitor.drivers.bacnet.BacnetProbe</JavaClass>
        <DataType>FLOAT</DataType>
        <ViewType>TEXTFIELD</ViewType>
        <PropertyList>
            <Property Name="ObjectType" Caption="对象类型 ID" Required="true">
                <DataType Min="0" Max="30">INT</DataType>
            </Property>
            <Property Name="InstanceNumber" Caption="对象编号" Required="true">
                <DataType Min="0">INT</DataType>
            </Property>
            <Property Name="PropertyIdentifier" Caption="属性 ID" Required="true" Default="85">
                <DataType Min="0" Max="341">INT</DataType>
            </Property>
        </PropertyList>
        <Source>BACnetService</Source>
    </Probe>

    <Probe Name="BACnetInt" Caption="BACnet 整型输入" Interval="30m">
        <JavaClass>com.systar.monitor.drivers.bacnet.BacnetProbe</JavaClass>
        <DataType>INT</DataType>
        <ViewType>TEXTFIELD</ViewType>
        <PropertyList>
            <Property Name="ObjectType" Caption="对象类型 ID" Required="true">
                <DataType Min="0" Max="30">INT</DataType>
            </Property>
            <Property Name="InstanceNumber" Caption="对象编号" Required="true">
                <DataType Min="0">INT</DataType>
            </Property>
            <Property Name="PropertyIdentifier" Caption="属性 ID" Required="true" Default="85">
                <DataType Min="0" Max="341">INT</DataType>
            </Property>
        </PropertyList>
        <Source>BACnetService</Source>
    </Probe>
</ProbeList>
